public class EjemploHilo {
    public static void main(String[] args) {

        Thread hilo = new Thread(new Runnable() {
            @Override
            public void run() {
                // Aquí va el método o la lógica que ejecutará el hilo
                miMetodo();
            }

            // Puedes definir el método dentro de la clase anónima
            private void miMetodo() {
                System.out.println("El hilo está ejecutando miMetodo()");
            }
        });

        // Activar el hilo
        hilo.start();
    }
}


public class EjemploHilo {
    public static void main(String[] args) {

        Thread hilo = new Thread(() -> {
            miMetodo();
        });

        hilo.start();
    }

    private static void miMetodo() {
        System.out.println("Ejecutando miMetodo() en un hilo");
    }
}
